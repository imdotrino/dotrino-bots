{
  "name": "@dotrino/bots",
  "version": "0.1.0",
  "description": "Colección de bots headless que simulan usuarios reales en las apps del ecosistema Dotrino (identidad propia, transporte por el proxy, cerebro DeepSeek, latencias humanas).",
  "type": "module",
  "private": true,
  "bin": {
    "cc-bots": "./src/run.js"
  },
  "scripts": {
    "start": "node src/run.js",
    "chat": "node src/run.js --app chat",
    "pm2:gen": "node src/gen-ecosystem.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ccbots",
    "pm2:restart": "pm2 restart ccbots",
    "pm2:delete": "pm2 delete ccbots",
    "pm2:logs": "pm2 logs ccbots",
    "pm2:status": "pm2 status",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dotrino/identity": "0.62.0",
    "@dotrino/lobby": "0.9.0",
    "@dotrino/proxy-client": "0.22.0",
    "@dotrino/reputation": "0.12.0",
    "stockfish": "^18.0.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pm2": "^5.4.3",
    "typescript": "5.9.3"
  },
  "author": "seyacat",
  "license": "MIT"
}
